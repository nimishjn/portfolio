# Postgres connection string (local: `pnpm db:up` starts one on port 54329)
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:54329/portfolio
# Any long random string, e.g. `openssl rand -hex 32`
PAYLOAD_SECRET=
# Public origin, used for canonical URLs, sitemap and JSON-LD
NEXT_PUBLIC_SITE_URL=https://nimish-jain.com
# Vercel Blob token; when unset, uploads are stored on local disk in /media
BLOB_READ_WRITE_TOKEN=
# Optional search-console verification tokens (the content value of the meta tag)
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
