{
  "name": "nimish-jain-com",
  "version": "2.0.0",
  "private": true,
  "description": "nimish-jain.com: academic personal site built with Next.js and Payload CMS",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "scripts": {
    "dev": "cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "build": "cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "vercel-build": "cross-env NODE_OPTIONS=--no-deprecation payload migrate && pnpm build",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint .",
    "typecheck": "tsc --noEmit",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "db:up": "docker compose up -d db",
    "seed": "cross-env NODE_OPTIONS=--no-deprecation payload run src/seed/index.ts",
    "icons": "node scripts/brand-icons.ts",
    "banners": "node scripts/banners.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.90.2",
    "@payloadcms/next": "3.90.2",
    "@payloadcms/richtext-lexical": "3.90.2",
    "@payloadcms/storage-vercel-blob": "3.90.2",
    "@payloadcms/ui": "3.90.2",
    "cross-env": "^7.0.3",
    "dotenv": "16.4.7",
    "geist": "1.7.2",
    "graphql": "^16.8.1",
    "lucide-static": "1.57.0",
    "next": "16.3.3",
    "payload": "3.90.2",
    "payload-theme": "0.9.4",
    "payload-totp": "3.0.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "sanitize-html": "^2.18.0",
    "sharp": "0.35.4"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.3",
    "@commitlint/config-conventional": "^21.2.3",
    "@playwright/test": "1.58.2",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.19.9",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/sanitize-html": "^2.16.2",
    "eslint": "^9.16.0",
    "eslint-config-next": "16.3.3",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "postcss": "^8.5.6",
    "prettier": "^3.4.2",
    "tailwindcss": "4.3.3",
    "typescript": "5.7.3"
  },
  "engines": {
    "node": "24.x",
    "pnpm": "^11"
  }
}
